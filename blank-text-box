<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Concept Check</title>

    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            background-color: transparent;
            font-family: Arial, sans-serif;
            color: #2d3b45;
        }

        .concept-check {
            box-sizing: border-box;
            width: 100%;
            padding: 12px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #0055a5;
            font-size: 1rem;
            font-weight: bold;
            line-height: 1.4;
        }

        textarea {
            box-sizing: border-box;
            width: 100%;
            min-height: 110px;
            padding: 12px;
            border: 2px solid #b4dcff;
            border-radius: 6px;
            background-color: #fcfdff;
            color: #2d3b45;
            font-family: Arial, sans-serif;
            font-size: 1rem;
            line-height: 1.5;
            resize: vertical;
        }

        textarea:focus {
            border-color: #0055a5;
            outline: 3px solid rgba(0, 85, 165, 0.18);
        }
    </style>
</head>

<body>
    <div class="concept-check">
        <label for="student-explanation">
            Write your answer here:
        </label>

        <textarea
            id="student-explanation"
            placeholder="..."
            spellcheck="true"
        ></textarea>
    </div>
</body>
</html>
